@inject BookCollectionService BookCollectionService
@inject BookNotificationService BookNotification
@implements IDisposable

<div class="py-8 space-y-6">
	<h1 class="text-2xl font-semibold">Library</h1>

	<input type="text" placeholder="Search books..." class="w-full px-4 py-2 bg-surface-card border border-border rounded-lg text-text-primary placeholder-text-tertiary focus:outline-hidden focus:border-accent transition-colors" />

	@if (bookIds.Any())
	{
		<div class="grid grid-cols-[repeat(auto-fill,minmax(140px,1fr))] gap-4">
			@foreach (var bookId in bookIds)
			{
				<BookGridItemComponent BookId="@bookId" />
			}
		</div>
	}
	else
	{
		<div class="flex flex-col items-center justify-center py-20 text-center">
			<p class="text-text-secondary mb-2">No books yet</p>
			<p class="text-text-tertiary text-sm">Tap the + button below to add your first book</p>
		</div>
	}
</div>

@code {
	IEnumerable<Guid> bookIds = [];

	protected override void OnInitialized()
	{
		BookNotification.OnBooksChanged += HandleBooksChanged;
		bookIds = BookCollectionService.GetAllBookIds();
	}

	void HandleBooksChanged()
	{
		bookIds = BookCollectionService.GetAllBookIds();
		InvokeAsync(StateHasChanged);
	}

	public void Dispose()
	{
		BookNotification.OnBooksChanged -= HandleBooksChanged;
	}
}
