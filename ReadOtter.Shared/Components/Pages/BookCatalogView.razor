@using ReadOtter.Shared.Data.Services
@inject BookCollectionService BookCommonService

<div class="BookCatalogView">
	<h2>Catalog</h2>

	<div class="BookCatalogView-Grid">
		@foreach (var bookId in bookIds)
		{
			<BookGridItemComponent BookId="@bookId"></BookGridItemComponent>
		}
	</div>

	<InputFile></InputFile>

	<button class="btn btn-primary add-book-button" @onclick=@AddBook></button>
</div>

@code {
	IEnumerable<Guid> bookIds = new List<Guid>();

	protected override void OnInitialized()
	{
		bookIds = BookCommonService.GetAllBookIds();
	}

	void AddBook()
	{
		
	}
}
