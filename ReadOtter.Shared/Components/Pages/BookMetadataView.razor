@using ReadOtter.Shared.Data.Models
@using ReadOtter.Shared.Data.Services
@using VersOne.Epub.Schema;
@inject EpubMetadataService EpubMetadataService

<div class="book-metadata">
	<img class="book-cover-image" />

	<h2>Descriptions</h2>
	@foreach (var description in metadata.Descriptions ?? [])
	{
		<p>@((MarkupString)description)</p>
	}

	<h2>Creators</h2>
	@GetContributorsList()

	<h2>Publishers</h2>
	@GetPublishersList()
</div>

@code { 
	//This does not currently display - do so in the near future
	[Parameter]
	public required Guid BookId { get; set; }

	BookMetaData metadata = new();

	protected override void OnParametersSet()
	{
		metadata = EpubMetadataService.GetMetaData(BookId);
	}

	string GetCreatorsList()
	{
		return string.Join(", ", metadata.Creators ?? []);
	}

	string GetPublishersList()
	{
		return string.Join(", ", metadata.Publishers ?? []);
	}

	string GetContributorsList()
	{
		return string.Join(", ", metadata.Contributors ?? []);
	}
}
