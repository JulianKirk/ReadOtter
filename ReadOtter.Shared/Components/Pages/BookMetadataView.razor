@inject EpubMetadataService EpubMetadataService
@inject BookCollectionService BookCollectionService
@inject NavigationManager Navigation
@inject InputService InputService
@implements IDisposable

<div class="py-8 space-y-6">

	<button @onclick='() => Navigation.NavigateTo("")' class="text-text-secondary hover:text-text-primary transition-colors text-sm flex items-center gap-1">
		<Icon Name="IconName.Back" CssClass="w-4 h-4" />
		<span>Home</span>
	</button>

	<div class="md:flex gap-8">
		<div class="w-48 flex-shrink-0 mb-6 md:mb-0">
			@if (!string.IsNullOrEmpty(coverImage))
			{
				<img src="@coverImage" class="aspect-[2/3] w-full object-cover rounded-lg bg-surface-raised" />
			}
			else
			{
				<div class="aspect-[2/3] w-full bg-surface-raised rounded-lg flex items-center justify-center">
					<span class="text-text-tertiary text-sm">No Cover</span>
				</div>
			}
		</div>

		<div class="flex-1 space-y-4">
			<h1 class="text-2xl font-semibold">@bookTitle</h1>

			@if (metadata.Creators?.Any() == true)
			{
				<p class="text-text-secondary">by @GetCreatorsList()</p>
			}

			@if (metadata.Publishers?.Any() == true)
			{
				<p class="text-sm text-text-tertiary">Publisher: @GetPublishersList()</p>
			}

			<div class="flex gap-3 pt-2">
				<button class="btn-primary" @onclick="ReadBook">Read</button>
				<button class="btn-danger-ghost" @onclick="ShowRemoveConfirmation">Remove</button>
			</div>
		</div>
	</div>

	@if (metadata.Descriptions?.Any() == true)
	{
		<section class="space-y-3 pt-4 border-t border-border">
			<h2 class="text-lg font-semibold">Description</h2>
			@foreach (var description in metadata.Descriptions)
			{
				<div class="text-text-secondary leading-relaxed">@((MarkupString)description)</div>
			}
		</section>
	}

	@if (metadata.Contributors?.Any() == true)
	{
		<section class="pt-4 border-t border-border">
			<h2 class="text-lg font-semibold mb-2">Contributors</h2>
			<p class="text-text-secondary">@GetContributorsList()</p>
		</section>
	}

</div>

<ConfirmationDialog
	IsVisible="@showConfirmation"
	Message="Are you sure you want to remove this book from your library?"
	ConfirmText="Remove"
	OnConfirm="RemoveBook"
	OnCancel="HideRemoveConfirmation" />

@code {
	[Parameter]
	public required Guid BookId { get; set; }

	BookMetaData metadata = new();
	string coverImage = string.Empty;
	string bookTitle = string.Empty;
	bool showConfirmation;

	protected override async Task OnInitializedAsync()
	{
		InputService.OnKeyDown += HandleKeyDown;
		await InputService.Initialize();
	}

	protected override void OnParametersSet()
	{
		metadata = EpubMetadataService.GetMetaData(BookId);
		coverImage = EpubMetadataService.GetCoverImage(BookId);
		bookTitle = EpubMetadataService.GetBookTitle(BookId);
	}

	void HandleKeyDown(string key)
	{
		if (key == "Escape") Navigation.NavigateTo("");
	}

	void ReadBook()
	{
		Navigation.NavigateTo($"reader/{BookId}");
	}

	void ShowRemoveConfirmation()
	{
		showConfirmation = true;
	}

	void HideRemoveConfirmation()
	{
		showConfirmation = false;
	}

	void RemoveBook()
	{
		BookCollectionService.RemoveBook(BookId);
		Navigation.NavigateTo("library-catalog");
	}

	string GetCreatorsList() => string.Join(", ", metadata.Creators ?? []);
	string GetPublishersList() => string.Join(", ", metadata.Publishers ?? []);
	string GetContributorsList() => string.Join(", ", metadata.Contributors ?? []);

	public void Dispose()
	{
		InputService.OnKeyDown -= HandleKeyDown;
	}
}
