@inject BookCollectionService BookCollectionService
@inject EpubMetadataService EpubMetadataService
@inject NavigationManager Navigation
@using ReadOtter.Shared.Src.Data

@inject IBookProvider BookProvider

<div class="py-8 space-y-8">

    @if (continueBook is not null)
    {
        <section>
            <h2 class="text-lg font-semibold mb-4">Continue Reading</h2>
            <div class="bg-surface-card border border-border rounded-lg p-4 flex gap-4">
                <div class="w-20 flex-shrink-0 aspect-[2/3] bg-surface-raised rounded-md overflow-hidden">
                    @if (!string.IsNullOrEmpty(continueCover))
                    {
                        <img src="@continueCover" class="w-full h-full object-cover" />
                    }
                </div>
                <div class="flex flex-col justify-center min-w-0 flex-1">
                    <p class="text-base font-semibold text-text-primary truncate">@continueBook.Title</p>
                    <p class="text-sm text-text-secondary">@continueAuthor</p>
                    <p class="text-xs text-text-tertiary mt-1">Chapter @(continueBook.CurrentChapter + 1) of @continueTotalChapters</p>
                    @if (continueTotalChapters > 0)
                    {
                        <div class="w-full bg-surface-raised rounded-full h-1.5 mt-2">
                            <div class="bg-accent h-1.5 rounded-full" style="width: @(Math.Round((double)(continueBook.CurrentChapter + 1) / continueTotalChapters * 100))%"></div>
                        </div>
                    }
                    <button class="mt-3 self-start btn-primary text-sm" @onclick="ContinueReading">Continue</button>
                </div>
            </div>
        </section>
    }

    @if (bookIds.Any())
    {
        <section>
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-lg font-semibold">Your Library</h2>
                <a href="library-catalog" class="text-sm text-accent hover:text-accent-hover transition-colors">See All</a>
            </div>
            <div class="grid grid-cols-[repeat(auto-fill,minmax(140px,1fr))] gap-4">
                @foreach (var bookId in bookIds.Take(6))
                {
                    <BookGridItemComponent BookId="@bookId" />
                }
            </div>
        </section>
    }
    else
    {
        <div class="flex flex-col items-center justify-center py-20 text-center">
            <p class="text-text-secondary mb-2">No books yet</p>
            <p class="text-text-tertiary text-sm">Tap the + button below to add your first book</p>
        </div>
    }

</div>

@code {
    IEnumerable<Guid> bookIds = [];
    Book? continueBook;
    string continueCover = string.Empty;
    string continueAuthor = string.Empty;
    int continueTotalChapters;

    protected override void OnInitialized()
    {
        LoadData();
    }

    void ContinueReading()
    {
        if (continueBook is not null)
        {
            Navigation.NavigateTo($"reader/{continueBook.Id}");
        }
    }

    void LoadData()
    {
        var allBooks = BookCollectionService.GetAllBooks().ToList();
        bookIds = allBooks.Select(b => b.Id);

        continueBook = allBooks
            .Where(b => b.CurrentChapter > 0)
            .OrderByDescending(b => b.CurrentChapter)
            .FirstOrDefault();

        if (continueBook is not null)
        {
            continueCover = EpubMetadataService.GetCoverImage(continueBook.Id);
            var meta = EpubMetadataService.GetMetaData(continueBook.Id);
            continueAuthor = meta.Creators?.Any() == true
                ? "by " + string.Join(", ", meta.Creators)
                : string.Empty;
            continueTotalChapters = BookProvider.GetChapterCount(continueBook.Id);
        }
    }
}
