@using ReadOtter.Shared.Src.Data.Database
@using ReadOtter.Shared.Src.Data
@using ReadOtter.Shared.Src.Services
@inject SeederService SeederService
@inject ReadOtterLibraryDbContext Context
@inject NavigationManager Navigation
@inject InputService InputService
@implements IDisposable

<div class="min-h-screen bg-surface-base text-text-primary p-6">
	<button @onclick="GoBack" class="text-text-secondary hover:text-text-primary transition-colors text-sm mb-6 flex items-center gap-1">
		<Icon Name="IconName.Back" CssClass="w-4 h-4" />
		<span>Settings</span>
	</button>

<h1 class="text-2xl font-semibold mb-6">Seeder</h1>

<button class="btn-primary" @onclick=@SeedData>Seed Data</button>

<button class="btn-primary" @onclick=@ClearSeededData>Clear Seeded Data</button>

<button class="btn-primary" @onclick=@ClearAllData>Clear All Data</button>

<br />

@foreach(var book in Context.Books)
{
	<li>@book.Id: @book.Title</li>
}

</div>

@code {
	protected override async Task OnInitializedAsync()
	{
		InputService.OnKeyDown += HandleKeyDown;
		await InputService.Initialize();
	}

	void HandleKeyDown(string key)
	{
		if (key == "Escape") GoBack();
	}

	void GoBack()
	{
		Navigation.NavigateTo("settings");
	}

	void SeedData()
	{
		SeederService.SeedData();
		StateHasChanged();
	}

	void ClearSeededData()
	{
		SeederService.ClearSeededData();
		StateHasChanged();
	}

	void ClearAllData()
	{
		SeederService.ClearAllData();
		StateHasChanged();
	}

	public void Dispose()
	{
		InputService.OnKeyDown -= HandleKeyDown;
	}
}
