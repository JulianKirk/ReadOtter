@using ReadOtter.Shared.Src.Data.Database
@using ReadOtter.Shared.Src.Data
@using ReadOtter.Shared.Src.Services
@inject SeederService SeederService
@inject ReadOtterLibraryDbContext Context

<h1>Seeder</h1>

<button class="btn-primary" @onclick=@SeedData>Seed Data</button>

<button class="btn-primary" @onclick=@ClearSeededData>Clear Seeded Data</button>

<button class="btn-primary" @onclick=@ClearAllData>Clear All Data</button>

<br />

@foreach(var book in Context.Books)
{
	<li>@book.Id: @book.Title</li>
}

@code {
	void SeedData() 
	{ 
		SeederService.SeedData();
		StateHasChanged();
	}

	void ClearSeededData() 
	{
		SeederService.ClearSeededData();
		StateHasChanged();
	}

	void ClearAllData() 
	{ 
		SeederService.ClearAllData();
		StateHasChanged();
	}
}
