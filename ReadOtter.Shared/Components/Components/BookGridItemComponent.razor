@inject EpubMetadataService EpubMetadataService
@inject NavigationManager Navigation

<div class="book-grid-item" @onclick=@ViewBook>
	@if (loadError)
	{
		<div class="book-grid-item-error">
			<p>Unable to load book data</p>
		</div>
	}
	else
	{
		<img src="@GetCoverImageBase64String()"/>

		<h2>Author(s)</h2>
		@GetCreatorsList()
		<br />

		<h2>Publisher(s)</h2>
		@GetPublishersList()
	}
</div>

@code {
	[Parameter]
	public required Guid BookId { get; set; }

	BookMetaData metadata = new();
	string coverImage = string.Empty;
	bool loadError;

	protected override void OnParametersSet()
	{
		try
		{
			metadata = EpubMetadataService.GetMetaData(BookId);
			coverImage = EpubMetadataService.GetCoverImage(BookId);
			loadError = false;
		}
		catch (Exception)
		{
			loadError = true;
		}
	}

	string GetCreatorsList()
	{
		return string.Join(", ", metadata.Creators ?? []);
	}

	string GetPublishersList()
	{
		return string.Join(", ", metadata.Publishers ?? []);
	}

	string GetCoverImageBase64String()
	{
		return coverImage;
	}

	void ViewBook()
	{
		Navigation.NavigateTo("reader/" + BookId);
	}
}
