@page "/reader/{BookId}"
@layout ReadOtter.Components.Layout.ReaderLayout

<ReadView BookId=@GetBookId()></ReadView>

@code {
	[Parameter]
	public required string BookId { get; set; }

	protected override void OnParametersSet()
	{
		StateHasChanged();
	}

	Guid GetBookId()
	{
		return Guid.Parse(BookId);
	}
}